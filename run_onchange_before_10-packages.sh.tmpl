#!/usr/bin/env bash
#
# Install the packages this configuration needs on top of a CachyOS Hyprland
# install, using shelly -- which CachyOS ships, so there is nothing to bootstrap
# before it can run, and which drives libalpm directly for repo *and* AUR
# packages.
#
# `run_onchange_` rather than `run_once_`: the package names are interpolated
# into this script, so editing .chezmoidata/packages.toml changes the rendered
# content and the next `chezmoi apply` re-runs it.
#
# `before_` so that the same apply which writes ~/.config/fish, ~/.config/hypr
# and friends lands on a machine that already has the programs those files
# configure.
#
# This is a bootstrap, not an updater: it works out what is missing first and
# does nothing at all when the answer is nothing. That matters because the repo
# install below syncs and upgrades in the same transaction -- installing against
# a stale database is how Arch systems get partially upgraded -- and firing that
# unannounced on every `chezmoi apply` would be rude.

set -euo pipefail

if ! command -v pacman >/dev/null 2>&1; then
    echo "==> not an Arch-based system; skipping package install"
    exit 0
fi

standard_packages=(
{{ range .packages.standard -}}
    {{ . | quote }}
{{ end -}}
)

aur_packages=(
{{ range .packages.aur -}}
    {{ . | quote }}
{{ end -}}
)

# `pacman -Qq` is the query here even though shelly does the installing: it is
# the same local database, and it answers without a sudo prompt.
missing_standard=()
for pkg in "${standard_packages[@]}"; do
    pacman -Qq -- "$pkg" >/dev/null 2>&1 || missing_standard+=("$pkg")
done

missing_aur=()
for pkg in "${aur_packages[@]}"; do
    pacman -Qq -- "$pkg" >/dev/null 2>&1 || missing_aur+=("$pkg")
done

if [ ${#missing_standard[@]} -eq 0 ] && [ ${#missing_aur[@]} -eq 0 ]; then
    echo "==> all $((${#standard_packages[@]} + ${#aur_packages[@]})) packages already installed"
    exit 0
fi

if ! command -v shelly >/dev/null 2>&1; then
    echo "!! shelly not found -- is this a CachyOS install?" >&2
    echo "   install it with: sudo pacman -S shelly" >&2
    exit 1
fi

# shelly shells out to sudo for the transaction itself, so prime the credential
# cache here rather than letting a password prompt appear halfway through a long
# download where it is easy to miss.
echo "==> sudo is needed to install ${#missing_standard[@]} repo and ${#missing_aur[@]} AUR packages"
sudo -v

if [ ${#missing_standard[@]} -gt 0 ]; then
    echo "==> repo: ${missing_standard[*]}"
    # -u syncs and upgrades before installing, in one transaction.
    shelly install standard -n -u --needed "${missing_standard[@]}"
fi

if [ ${#missing_aur[@]} -eq 0 ]; then
    exit 0
fi

# One package per call: these build from source and pull large upstream
# binaries, so a single failure should not cost the whole set.
echo "==> AUR: ${missing_aur[*]}"
for pkg in "${missing_aur[@]}"; do
    echo "    building $pkg"
    shelly install aur -n "$pkg" ||
        echo "    !! $pkg failed; install it by hand later" >&2
done
