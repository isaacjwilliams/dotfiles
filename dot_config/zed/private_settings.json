// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "file_finder": {
    "modal_max_width": "large",
  },
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "mode": "agent-full-access",
        "fast-mode": "on",
        "reasoning_effort": "ultra",
      },
      "type": "registry",
    },
  },
  "cli_default_open_behavior": "new_window",
  "diff_view_style": "unified",
  "project_panel": {
    "dock": "right",
  },
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "git_panel": {
    "tree_view": true,
    "dock": "right",
    "sort_by_path": false,
  },
  "show_edit_predictions": false,
  "sticky_scroll": {
    "enabled": true,
  },
  "edit_predictions": {
    "mode": "eager",
  },
  "ui_font_weight": 400.0,
  "buffer_font_family": "EnvyCodeR Nerd Font Mono",
  "ui_font_family": "EnvyCodeR Nerd Font Mono",
  "buffer_line_height": "standard",
  "buffer_font_weight": 400.0,
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "vim_mode": true,
  "base_keymap": "JetBrains",
  "ui_font_size": 15.0,
  "buffer_font_size": 12.0,
  "theme": "Tokyo Night",
  "tab_size": 2,
  "format_on_save": "on",
  "remove_trailing_whitespace_on_save": true,
  "languages": {
    "Ruby": {
      "tab_size": 2,
      "formatter": "language_server",
      "language_servers": ["ruby-lsp", "!solargraph"],
      "preferred_line_length": 140,
      "soft_wrap": "preferred_line_length",
      "wrap_guides": [80, 140],
    },
    "ERB": {
      "language_servers": ["ruby-lsp"],
      "formatter": "language_server",
      "tab_size": 2,
    },
    "Slim": {
      "language_servers": ["ruby-lsp"],
      "formatter": "language_server",
      "tab_size": 2,
    },
    "Markdown": {
      "preferred_line_length": 120,
      "wrap_guides": [80, 120],
    },
    "JavaScript": {
      "formatter": "language_server",
      "language_servers": ["eslint"],
      "wrap_guides": [80, 140],
    },
  },
  "lsp": {
    "ruby-lsp": {
      "initialization_options": {
        "enabledFeatures": {
          "diagnostics": true,
          "formatting": true,
          "semanticHighlighting": false,
          "debugging": true,
        },
        "formatter": "rubocop",
        "featuresConfiguration": {
          "inlayHint": {
            "enableAll": false,
          },
          "debugging": {
            "enabled": true,
            "attachMode": "remote",
            "remotePort": 38698,
          },
        },
        "rubyVersionManager": {
          "identifier": "auto",
        },
      },
    },
  },
  "file_types": {
    "Ruby": [
      "*.rb",
      "*.rake",
      "Rakefile",
      "Gemfile",
      "*.gemspec",
      "Guardfile",
      "Capfile",
      "*.ru",
      "*.thor",
      "*.jbuilder",
      "*.rbuild",
      ".irbrc",
      ".pryrc",
    ],
  },
  "context_servers": {
    "chrome-devtools": {
      "command": "npx",
      "args": ["chrome-devtools-mcp@latest", "--autoConnect"],
    },
    "sentry": {
      "url": "https://mcp.sentry.dev/mcp",
    },
  },
  "agent": {
    "notify_when_agent_waiting": "primary_screen",
    "play_sound_when_agent_done": "when_hidden",
    "dock": "left",
    "default_profile": "write",
    "tool_permissions": {
      "default": "confirm",
      "tools": {
        "terminal": {
          "default": "confirm",
          "always_allow": [
            { "pattern": "^bundle\\s+exec\\s+rspec(\\s|$)" },
            { "pattern": "^bin/rails\\s+runner\\s+-e\\s+test(\\s|$)" },
            {
              "pattern": "^RAILS_ENV=test\\s+bundle\\s+exec\\s+rails\\s+db:drop(\\s|$)",
            },
            {
              "pattern": "^RAILS_ENV=test\\s+bundle\\s+exec\\s+rails\\s+db:create(\\s|$)",
            },
            { "pattern": "^bundle\\s+exec\\s+rubocop(\\s|$)" },
            { "pattern": "^sem\\s+get\\s+pipelines(\\s|$)" },
            { "pattern": "^sem\\s+get\\s+job(\\s|$)" },
            { "pattern": "^sem\\s+logs(\\s|$)" },
          ],
        },
      },
    },
    "inline_assistant_model": {
      "provider": "openai-subscribed",
      "model": "gpt-5.5",
    },
    "use_modifier_to_send": true,
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "openai-subscribed",
      "model": "gpt-5.5",
    },
  },
  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": {
      "enabled": true,
      "delay_ms": 800,
    },
    "gutter_debounce": 300,
  },
}
